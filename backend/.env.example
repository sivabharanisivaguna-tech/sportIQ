# ==========================================================
# SportIQ Platform Configuration Template
# ==========================================================
# Copy this file to .env in backend/ directory:
# cp .env.example .env

PROJECT_NAME="SportIQ AI Talent Platform"
ENVIRONMENT="development" # Change to "production" when live
DATABASE_URL="sqlite:///./sportiq.db"
SECRET_KEY="sportiq_super_secret_jwt_key_2026_change_in_production"
OTP_SECRET_SALT="sportiq_secure_otp_salt_2026"

# ----------------------------------------------------------
# Gmail SMTP Configuration (Production Email OTP Delivery)
# ----------------------------------------------------------
# 1. Go to Google Account -> Security -> 2-Step Verification
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create app "SportIQ" and copy the 16-character password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_16_character_app_password"
SMTP_FROM_EMAIL="your_email@gmail.com"
SMTP_FROM_NAME="SportIQ Athlete Intelligence"
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# ----------------------------------------------------------
# Future SMS Configuration (Twilio)
# ----------------------------------------------------------
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
